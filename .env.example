# MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=meter_app
MYSQL_PASSWORD=meter_pass
MYSQL_DATABASE=smartmeter

# Kafka connection
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC=smartmeter-events
KAFKA_GROUP_ID=smartmeter-processor
KAFKA_AUTO_OFFSET_RESET=earliest

# Stream and dashboard tuning
STREAM_DELAY=0.2
DASHBOARD_REFRESH_SECONDS=2
DASHBOARD_ROW_LIMIT=200
ENERGY_INTERVAL_MINUTES=1.0
LOG_LEVEL=INFO

# Optional path overrides. Paths may be absolute or relative to the project root.
# CSV_PATH=data/household_power.csv
# MODEL_PATH=models/anomaly_model.pkl
